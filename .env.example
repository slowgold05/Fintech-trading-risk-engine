DATABASE_URL=postgresql+psycopg://fintech_app:YOUR_APP_PASSWORD@localhost:5433/fintechapp
MIGRATION_DATABASE_URL=postgresql+psycopg://fintech_migrate:YOUR_MIGRATION_PASSWORD@localhost:5433/fintechapp
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
SEC_USER_AGENT=FintechRiskPlatform your-email@example.com
MARKET_HOT_REFRESH_MINUTES=15
MARKET_DAILY_REFRESH_HOURS=24
MARKET_REQUEST_DELAY_SECONDS=12
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=30
REFRESH_COOKIE_SECURE=false
ENABLE_HSTS=false
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Set true and restart the API to block new orders and direct trades.
TRADING_HALTED=false
# Hosted API only. Local Compose leaves this off and uses its own migration command.
SCHEDULED_JOBS_ENABLED=false
SCHEDULED_JOB_INTERVAL_HOURS=24
SCHEDULED_MARKET_HOT_LIMIT=200
SCHEDULED_MARKET_DAILY_LIMIT=100
MAX_STOCK_CONCENTRATION_PCT=50
MAX_STOCK_POSITION_NOTIONAL=50000
# Leave false until every account has a confirmed authenticator. Enrolled accounts still complete a code.
MFA_REQUIRED=false
IMPOSSIBLE_TRAVEL_MINUTES=60
# Optional CIDR=region pairs, comma-separated. Empty means no IP is treated as travel.
LOGIN_GEO_PREFIXES=
LARGE_ORDER_STEP_UP_NOTIONAL=10000
# Leave empty to screen names against the local fixture. A URL calls that yente instance.
YENTE_URL=
YENTE_MATCH_THRESHOLD=0.85
# Expansion providers stay empty. Empty keys do not call Massive, Finnhub, or Twelve Data.
MASSIVE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
KRONOS_CHECKPOINT=
