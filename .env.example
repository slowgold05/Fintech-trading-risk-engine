DATABASE_URL=mysql+pymysql://fintech_app:YOUR_APP_PASSWORD@localhost:3306/fintechapp
MIGRATION_DATABASE_URL=mysql+pymysql://migration_user:YOUR_MIGRATION_PASSWORD@localhost:3306/fintechapp
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
SEC_USER_AGENT=FintechRiskPlatform your-email@example.com
MARKET_HOT_REFRESH_MINUTES=15
MARKET_DAILY_REFRESH_HOURS=24
MARKET_REQUEST_DELAY_SECONDS=12
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=30
REFRESH_COOKIE_SECURE=false
ENABLE_HSTS=false
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Set true and restart the API to block new orders and direct trades.
TRADING_HALTED=false
MAX_STOCK_CONCENTRATION_PCT=50
